{
  "name": "firstwrite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run build --workspace=@firstwrite/shared && npm run typecheck --workspaces --if-present",
    "test": "npm run build --workspace=@firstwrite/shared && vitest run",
    "check": "npm run lint && npm run typecheck && npm run test",
    "db:migrate": "npm run db:migrate --workspace=@firstwrite/api",
    "db:seed": "npm run db:seed --workspace=@firstwrite/api",
    "db:reencrypt": "npm run db:reencrypt --workspace=@firstwrite/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.9.0",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
