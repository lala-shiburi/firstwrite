# ─────────────────────────────────────────────────────────────
# Morning Pages (firstwrite) — Environment Configuration
# Copy this file to .env for local development:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# Runtime environment: development | test | production
NODE_ENV=development

# Port the Express API listens on inside its container / process
PORT=3000

# Public base URL of the web application (used for CORS, email links, and CSRF origin checks)
APP_BASE_URL=http://localhost:5173

# Express "trust proxy" setting for running behind Traefik reverse proxy (hop count or true/false)
TRUST_PROXY=1

# ───────────── Database (PostgreSQL 15+) ─────────────
# Connection string used by the API, Drizzle migrations, and pg-boss job queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/firstwrite

# ───────────── Application-Layer Encryption (AES-256-GCM) ─────────────
# Active key version used for encrypting new journal entries and weekly summaries
ENCRYPTION_KEY_CURRENT_VERSION=1

# 32-byte encryption key for version 1 (64 hex characters or 44 base64 characters)
# Generate a fresh key with: openssl rand -hex 32
ENCRYPTION_KEY_V1=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Optional JSON map of additional key versions for key rotation (e.g. {"1":"...","2":"..."})
ENCRYPTION_KEYS_JSON=

# ───────────── Authentication & Sessions ─────────────
# Secret used for signing/CSRF protection (minimum 32 characters)
# Generate with: openssl rand -hex 32
SESSION_SECRET=dev-session-secret-do-not-use-in-production-0123456789

# Cloudflare Turnstile bot protection on registration (true | false)
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=

# ───────────── Web Push Notifications (VAPID) ─────────────
# Generate a keypair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=BEl62iUYgUivxIkv69yViEuiBIa-Ib9-SkvMeAtA3LFgDzkrxZJjSgSnfckjBJuBkr3qBUYIHBQFLXYp5Nksh8U
VAPID_PRIVATE_KEY=UUxI4O8-FbRouAevSmBQ6o18hgE4nSG3qwvJTfKc-ls
VAPID_SUBJECT=mailto:notifications@example.com

# Expose VAPID public key and API base URL to the Vite frontend
VITE_VAPID_PUBLIC_KEY=BEl62iUYgUivxIkv69yViEuiBIa-Ib9-SkvMeAtA3LFgDzkrxZJjSgSnfckjBJuBkr3qBUYIHBQFLXYp5Nksh8U
VITE_API_BASE_URL=http://localhost:3000

# ───────────── Transactional Email Provider ─────────────
# Provider adapter: console | resend | postmark | ses (never raw SMTP from VPS)
EMAIL_PROVIDER=console
EMAIL_PROVIDER_API_KEY=dev-email-api-key
EMAIL_FROM=Morning Pages <noreply@example.com>

# ───────────── LLM Provider & Spend Limits (Weekly Summaries) ─────────────
# Provider: anthropic | mock
LLM_PROVIDER=anthropic
LLM_API_KEY=dev-llm-api-key
LLM_MODEL=claude-haiku-5-5

# Monthly spend ceiling in USD; pauses summary generation when reached
LLM_MONTHLY_SPEND_LIMIT_USD=50
